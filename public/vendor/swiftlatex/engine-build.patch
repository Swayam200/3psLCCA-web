+/** FNV-1a fingerprint of the cross-reference files (.aux/.toc/.lof/.lot).
+ * When a compile leaves them unchanged, the run has converged and no rerun
+ * is needed (the rule latexmk uses); callers compare across passes. */
+function auxFingerprint() {
+    const stem = WORKROOT + "/" + self.mainfile.substr(0, self.mainfile.length - 4);
+    let h = 0x811c9dc5;
+    for (const ext of ['.aux', '.toc', '.lof', '.lot']) {
+        let data;
+        try {
+            data = FS.readFile(stem + ext, { encoding: 'binary' });
+        } catch (err) {
+            data = [0];
+        }
+        for (let i = 0; i < data.length; i++) {
+            h ^= data[i];
+            h = (h * 0x01000193) >>> 0;
+        }
+    }
+    return h >>> 0;
+}
+
 function compileLaTeXRoutine() {
     prepareExecutionContext();
     const setMainFunction = cwrap('setMainEntry', 'number', ['string']);
     setMainFunction(self.mainfile);
+    const auxBefore = auxFingerprint();
     let status = _compileLaTeX();
-    if (status === 0) {
-        let pdfArrayBuffer = null;
+    // Like the pdflatex CLI: recovered errors exit 1 but still produce a
+    // PDF. The output file's existence decides success; callers can still
+    // inspect the log for errors they consider fatal.
+    let pdfArrayBuffer = null;
+    if (status === 0 || status === 1) {
         _compileBibtex();
         try {
             let pdfurl = WORKROOT + "/" + self.mainfile.substr(0, self.mainfile.length - 4) + ".pdf";
@@ -126,31 +151,35 @@ function compileLaTeXRoutine() {
