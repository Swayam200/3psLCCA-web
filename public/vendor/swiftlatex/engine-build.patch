-                'log': self.memlog,
-                'cmd': 'compile'
-            });
-            return;
+            pdfArrayBuffer = null;
+        }
+    }
+    if (pdfArrayBuffer === null) {
+        console.error("Compilation failed, with status code " + status);
+        // The terminal stream loses the final error on abnormal exit; the
