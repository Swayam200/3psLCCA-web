# ==============================================================================
# 3psLCCA-web environment configuration
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# Everything here is OPTIONAL for a first run: without any `.env` the app
# boots in guest mode (projects stored in the browser via localStorage) and
# expects the calculation backend on http://localhost:8000.
# ==============================================================================

# ------------------------------------------------------------------------------
# Calculation engine
#
# By default calculations run IN THE BROWSER via the official 3psLCCA-core
# engine published on GitHub Pages (Pyodide + the core wheel, loaded from the
# CDN). If that engine cannot load (offline, CDN outage), the app falls back
# to the FastAPI backend below.
#
# VITE_LCCA_ENGINE pins one engine and disables the fallback:
#   browser  always use the in-browser engine (error if the CDN is down)
#   backend  always use the FastAPI backend
#VITE_LCCA_ENGINE=

# Override the published engine release or the Pyodide runtime (rarely needed).
# When overriding the engine URL, also set its subresource-integrity hash from
# the release page (VITE_LCCA_ENGINE_SRI) — otherwise the script loads without
# an integrity check.
#VITE_LCCA_ENGINE_URL=https://3pslcca.github.io/3psLCCA-core/release/v1.0.2/3pslccacore.js
#VITE_LCCA_ENGINE_SRI=sha256-riQ+g+lkFBbz1VzpMSbp5YozEAjy92QYwmzpuETwiPg=
#VITE_LCCA_PYODIDE_URL=https://cdn.jsdelivr.net/pyodide/v314.0.2/full/pyodide.js

# URL of the FastAPI fallback backend (see docs/backend-setup.md).
# Default: http://localhost:8000
VITE_LCCA_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# AI assistant (OPTIONAL, off by default)
#
# Set to "true" to include the read-only AI assistant in the build (Results
# page panel + Settings tab). When unset, none of the AI code ships in the
# bundle. Users still have to turn the assistant on at runtime in
# Settings -> AI Assistant, and model providers are configured there too
# (bring-your-own-key or an organisation proxy). See docs/ai-setup.md.
#VITE_AI_ENABLED=true

# ------------------------------------------------------------------------------
# Appwrite (authentication + cloud project sync)
#
# OPTIONAL. Leave these unset to run the app in guest/offline-only mode
# (login is disabled, projects stay in the browser). To enable sign-in and
# cloud sync, create an Appwrite project and fill in all four values.
# Full walkthrough: docs/appwrite-setup.md
# ------------------------------------------------------------------------------

# API endpoint of your Appwrite deployment, e.g.
#   https://cloud.appwrite.io/v1        (Appwrite Cloud, default region)
#   https://fra.cloud.appwrite.io/v1    (Appwrite Cloud, Frankfurt)
#   https://appwrite.example.com/v1     (self-hosted)
#VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project ID from the Appwrite console (Settings -> API credentials).
#VITE_APPWRITE_PROJECT_ID=your_project_id

# Database ID of the database that holds the projects collection.
#VITE_APPWRITE_DATABASE_ID=your_database_id

# Collection (table) ID where project documents are stored.
# The collection needs the attributes described in docs/appwrite-setup.md.
#VITE_APPWRITE_COLLECTION_ID=project_data
