VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id_here
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_DATABASE_ID=your_database_id_here
VITE_APPWRITE_COLLECTION_ID=your_collection_id_here
VITE_LCCA_API_URL=http://localhost:8000

# WASM engine asset sources (CDN-first with bundled fallback).
# Unset = use the defaults below; set to an empty string to force bundled-only
# (e.g. offline development). CDN wheels are sha256-verified against the build
# manifest and fall back to the bundled copy on any failure.
# VITE_LCCA_PYODIDE_CDN=https://cdn.jsdelivr.net/pyodide/v<pyodide-version>/full/
# VITE_LCCA_WHEEL_CDN=https://swayam200.github.io/3psLCCA-core/wasm-demo/
