# ==============================================================================
# 3psLCCA-web environment configuration
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# Everything here is OPTIONAL for a first run: without any `.env` the app
# boots in guest mode (projects stored in the browser via localStorage) and
# expects the calculation backend on http://localhost:8000.
# ==============================================================================

# ------------------------------------------------------------------------------
# Calculation backend (FastAPI)
#
# URL of the calculation backend that wraps the `three_ps_lcca_core` Python
# engine. Required for running calculations. See docs/backend-setup.md.
# Default: http://localhost:8000
# ------------------------------------------------------------------------------
VITE_LCCA_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Appwrite (authentication + cloud project sync)
#
# OPTIONAL. Leave these unset to run the app in guest/offline-only mode
# (login is disabled, projects stay in the browser). To enable sign-in and
# cloud sync, create an Appwrite project and fill in all four values.
# Full walkthrough: docs/appwrite-setup.md
# ------------------------------------------------------------------------------

# API endpoint of your Appwrite deployment, e.g.
#   https://cloud.appwrite.io/v1        (Appwrite Cloud, default region)
#   https://fra.cloud.appwrite.io/v1    (Appwrite Cloud, Frankfurt)
#   https://appwrite.example.com/v1     (self-hosted)
#VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project ID from the Appwrite console (Settings -> API credentials).
#VITE_APPWRITE_PROJECT_ID=your_project_id

# Database ID of the database that holds the projects collection.
#VITE_APPWRITE_DATABASE_ID=your_database_id

# Collection (table) ID where project documents are stored.
# The collection needs the attributes described in docs/appwrite-setup.md.
#VITE_APPWRITE_COLLECTION_ID=project_data
